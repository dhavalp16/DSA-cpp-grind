{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile and run",
      "type": "shell",
      // This command is now a single string formatted for PowerShell.
      "command": "copy '${file}' '.\\jspwTest.cpp'; g++ '.\\jspwTest.cpp' -o '.\\jspwTest'; Get-Content '.\\input.txt' | .\\jspwTest > '.\\output.txt'; del '.\\jspwTest.exe'; del '.\\jspwTest.cpp'",
      // "args" is no longer needed as everything is in the command string.
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": [
          "relative",
          "${workspaceRoot}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    }
  ]
}